#!/usr/bin/env bash
# surikat-tmux: apply surikat's tmux formats and key bindings to the running
# server. Run from surikat.conf (install.sh) or surikat.tmux (TPM).
#
#   surikat-tmux            apply (idempotent; safe to run on every re-source)
#   surikat-tmux --remove   undo everything
#
# Prepends per-pane icons to the window formats and appends the summary to
# status-right. It never replaces the user's own styling. Keys are set with
# @surikat_key_{dashboard,next,back,tree} (prefix table; "" or none = unbound).

set -u

WIN='#{E:@surikat_window_icons}'
# The icon formats come from surikat's theme (@surikat_style and
# @surikat_color_*), so they are defined in one place.
here=$(cd "$(dirname "$0")" && pwd)
ICON=$("$here/surikat" --tmux-icon 2>/dev/null)
MARK=$("$here/surikat" --tmux-mark 2>/dev/null)
[ -n "$ICON" ] || ICON='#{?#{==:#{@surikat},perm},🔴 ,#{?#{==:#{@surikat},ask},❓ ,#{?#{==:#{@surikat},idle},🟡 ,#{?#{==:#{@surikat},done},🟢 ,#{?#{==:#{@surikat},running},⚙ ,}}}}}'
[ -n "$MARK" ] || MARK='#{?#{==:#{@surikat_mark},fav},★,#{?#{==:#{@surikat_mark},side},↓,}}'

# Where `surikat` lives, as tmux should call it through sh. Keep a literal ~
# for paths under $HOME so the formats stay readable and portable; quote
# paths with unusual characters.
abs=${SURIKAT_BIN:-$here}
bin=$abs
case $bin in
  "$HOME"/*) bin="~${bin#"$HOME"}" ;;
esac
case $bin in
  *[!A-Za-z0-9_./~+@-]*) SK="'${abs//\'/\'\\\'\'}/surikat'" ;;
  *) SK="$bin/surikat" ;;
esac
COUNT=" #($SK --count)"

TREE_FMT='#{?pane_format,#{E:@surikat_tree_pane_icon}#{pane_current_command}  #{pane_current_path},#{?window_format,#{E:@surikat_tree_window_icons}#{window_name}#{window_flags},#{session_windows} windows#{?session_attached, (attached),}}}'

get() { tmux show -gv "$1" 2>/dev/null; }

# Remember an option's value before the first change, so --remove can
# restore it.
save() {
  [ -n "$(get "@surikat_orig_$1")" ] || tmux set -g "@surikat_orig_$1" "$2"
}

strip_count() { sed "s| #([^)]*/surikat'\{0,1\} --count)||g"; }

# key NAME DEFAULT: the key configured for NAME; empty if disabled.
key() {
  local v
  if v=$(get "@surikat_key_$1"); then
    [ "$v" = none ] && v=
    printf '%s' "$v"
  else
    printf '%s' "$2"
  fi
}

ours() { tmux list-keys -T prefix "$1" 2>/dev/null | grep -q surikat; }

# Unbind the keys surikat bound and restore what they did before.
restore_keys() {
  local k keys legacy=0 legacy_c=0 orig tmp
  # Installs from before the keys were saved always bound C, N, P and T,
  # and C was tmux's customize-mode.
  keys=$(get @surikat_keys) || {
    keys='C N P T'
    legacy=1
  }
  for k in $keys; do
    if ours "$k"; then
      tmux unbind -T prefix "$k"
      [ "$legacy.$k" = 1.C ] && legacy_c=1
    fi
  done
  orig=$(get @surikat_orig_keys)
  if [ -n "$orig" ]; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/surikat-keys.XXXXXX") && {
      printf '%s\n' "$orig" >"$tmp"
      tmux source-file "$tmp"
      rm -f "$tmp"
    }
  fi
  [ $legacy_c = 1 ] && tmux bind -T prefix C customize-mode -Z
  tmux set -gu @surikat_keys \; set -gu @surikat_orig_keys
  return 0
}

# bind_key KEY COMMAND...: bind in the prefix table, saving the old binding.
KEYS='' ORIG=''
bind_key() {
  local k=$1 old
  shift
  [ -n "$k" ] || return 0
  old=$(tmux list-keys -T prefix "$k" 2>/dev/null)
  [ -n "$old" ] && ORIG="$ORIG${ORIG:+$'\n'}$old"
  KEYS="$KEYS${KEYS:+ }$k"
  tmux bind -T prefix "$k" "$@"
}

apply_keys() {
  restore_keys
  KEYS='' ORIG=''
  bind_key "$(key dashboard C)" display-popup -E -w 85% -h 80% "$SK"
  bind_key "$(key next N)" run-shell -b "$SK --next --client '#{client_name}'"
  bind_key "$(key back P)" run-shell -b "$SK --back --client '#{client_name}'"
  bind_key "$(key tree T)" choose-tree -Zw -F "$TREE_FMT"
  tmux set -g @surikat_keys "$KEYS"
  [ -n "$ORIG" ] && tmux set -g @surikat_orig_keys "$ORIG"
  return 0
}

apply() {
  tmux set -g @surikat_pane_icon "$ICON" \; \
    set -g @surikat_window_icons '#{P:#{E:@surikat_pane_icon}}' \; \
    set -g @surikat_mark_icon "$MARK" \; \
    set -g @surikat_tree_pane_icon '#{E:@surikat_mark_icon}#{E:@surikat_pane_icon}' \; \
    set -g @surikat_tree_window_icons '#{P:#{E:@surikat_tree_pane_icon}}'

  local o v n
  for o in window-status-format window-status-current-format; do
    v=$(get "$o")
    case $v in
      *"$WIN"*) ;;
      *) tmux set -g "$o" "$WIN$v" ;;
    esac
  done

  v=$(get status-right)
  case $v in
    *"/surikat --count)"* | *"/surikat' --count)"*) ;;
    *) tmux set -g status-right "$v$COUNT" ;;
  esac

  n=$(get status-right-length)
  if [ "${n:-0}" -lt 80 ] 2>/dev/null; then
    save status_right_length "${n:-0}"
    tmux set -g status-right-length 80
  fi

  n=$(get status-interval)
  if [ "${n:-0}" -eq 0 ] 2>/dev/null || [ "${n:-0}" -gt 5 ] 2>/dev/null; then
    save status_interval "${n:-0}"
    tmux set -g status-interval 5
  fi

  apply_keys
}

remove() {
  local o v
  for o in window-status-format window-status-current-format; do
    v=$(get "$o")
    case $v in
      *"$WIN"*) tmux set -g "$o" "${v//"$WIN"/}" ;;
    esac
  done

  v=$(get status-right)
  case $v in
    *"/surikat --count)"* | *"/surikat' --count)"*)
      tmux set -g status-right "$(printf '%s' "$v" | strip_count)" ;;
  esac

  v=$(get @surikat_orig_status_right_length)
  [ -n "$v" ] && tmux set -g status-right-length "$v"
  v=$(get @surikat_orig_status_interval)
  [ -n "$v" ] && tmux set -g status-interval "$v"

  restore_keys

  tmux set -gu @surikat_pane_icon \; set -gu @surikat_window_icons \; \
    set -gu @surikat_mark_icon \; set -gu @surikat_tree_pane_icon \; \
    set -gu @surikat_tree_window_icons \; \
    set -gu @surikat_orig_status_right_length \; set -gu @surikat_orig_status_interval

  local p
  for p in $(tmux list-panes -a -F '#{pane_id}' 2>/dev/null); do
    tmux set -pu -t "$p" @surikat \; set -pu -t "$p" @surikat_mark 2>/dev/null
  done
}

case ${1:-} in
  "") apply ;;
  --remove) remove ;;
  -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "usage: surikat-tmux [--remove]" >&2
    exit 2
    ;;
esac
